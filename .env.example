# SmartZero 2.0 AI Provider Configuration (server only)
# Options: gemini | openrouter | featherless | deterministic
AI_PROVIDER=gemini
AI_MODEL=

# Google Gemini API (Free tier candidate)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (Free models support)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Featherless AI (Legacy / alternative provider)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_REASONING_MODEL=zai-org/GLM-5.3-Flash

# Edge-TTS (Microsoft Neural Voice Narration) - server only
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=-5%

# ==============================================================================
# Supabase Persistence & Authentication (REQUIRED FOR PRODUCTION)
# ==============================================================================
# 1. Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Supabase Anon / Publishable Key (Dashboard -> Project Settings -> API -> anon/public key)
# Note: NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted as a compatible alias
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 3. Supabase Service Role Key (Dashboard -> Project Settings -> API -> service_role key)
# CRITICAL: Server-only! Used by server APIs for student registration RPC, admin ops, and contest management.
# NEVER prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Student Session Cryptographic Security (REQUIRED FOR PRODUCTION)
# ==============================================================================
# Cryptographic secret used for HMAC-SHA256 signing of student session tokens.
# REQUIRED in production: Must be a random, high-entropy secret of at least 32 characters.
# Server-only. If missing or <32 characters in production, student session creation strictly fails closed.
# Generate with: openssl rand -base64 32
SMARTZERO_SESSION_SECRET=

# Global Live AI toggle: set to false to force local deterministic fallback mode
SMARTZERO_ENABLE_LIVE_AI=true

# Isolated Coding Judge Execution Mode
# - local: Local development mode. Uses HardenedSubprocessSandbox; Docker NOT required.
# - production: Production security mode. Requires dedicated Linux worker + Docker/gVisor.
#               STRICT FAIL-CLOSED: If container runner is unavailable, returns SYSTEM_ERROR.
#               Host subprocess execution is STRICTLY PROHIBITED in production.
SMARTZERO_JUDGE_MODE=local
