# Featherless AI - server only (Chat & Reasoning LLM)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Edge-TTS (Microsoft Neural Voice Narration) - server only
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=-5%


# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to false to force local fallback demo mode
SMARTZERO_ENABLE_LIVE_AI=true
