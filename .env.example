# SmartZero 2.0 AI Provider Configuration (server only)
# Options: gemini | openrouter | featherless | deterministic
AI_PROVIDER=gemini
AI_MODEL=

# Google Gemini API (Free tier candidate)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (Free models support)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Featherless AI (Legacy / alternative provider)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_REASONING_MODEL=zai-org/GLM-5.3-Flash

# Edge-TTS (Microsoft Neural Voice Narration) - server only
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=-5%

# Supabase Persistence & Authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (server only, for super_admin ops)

# Global Live AI toggle: set to false to force local deterministic fallback mode
SMARTZERO_ENABLE_LIVE_AI=true

# Isolated Coding Judge Execution Mode
# - local: Local development mode. Uses HardenedSubprocessSandbox; Docker NOT required.
# - production: Production security mode. Requires dedicated Linux worker + Docker/gVisor.
#               STRICT FAIL-CLOSED: If container runner is unavailable, returns SYSTEM_ERROR.
#               Host subprocess execution is STRICTLY PROHIBITED in production.
SMARTZERO_JUDGE_MODE=local
